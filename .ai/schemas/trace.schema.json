{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Code Trace",
  "type": "object",
  "required": [
    "id",
    "nodes",
    "edges"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
